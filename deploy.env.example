# Copy to .env at the repository root. .env is gitignored.
ENVIRONMENT=production
APP_DOMAIN=review.example.com
APP_ORIGIN=https://review.example.com
GITHUB_CALLBACK_URL=https://review.example.com/auth/github/callback

# Generate different values with: openssl rand -hex 32
API_KEY=replace-with-64-hex-characters
SESSION_SECRET=replace-with-different-64-hex-characters
ALLOWED_GITHUB_USERS=your-github-username

# Keep false unless all repository code and PR authors are trusted.
RUN_REPOSITORY_TESTS=false

# Keep these two values consistent. URL-encode the password in DATABASE_URL if needed.
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgres://review:replace-with-a-strong-database-password@postgres:5432/ai_review

# Optional multi-host overrides (Compose service-name defaults are used otherwise):
# REDIS_URL=redis://redis:6379/0
# REDIS_ADDR=redis:6379
# API_BASE_URL=http://api:8080
# API_INTERNAL_URL=http://api:8080
# AI_SERVICE_URL=http://ai-service:8000
# WORKER_METRICS_URL=http://worker:9090/metrics
