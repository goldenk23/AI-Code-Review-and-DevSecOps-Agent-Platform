# Copy this file to `.env` and fill in real values.
# `.env` is gitignored -- never commit real secrets.

# OpenCode Go API key (get it from https://opencode.ai/auth). Required --
# the review agent refuses to start without it.
OPENCODE_GO_API_KEY=your-opencode-go-api-key

# Optional overrides:
# OPENCODE_GO_MODEL=glm-5.2
# OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
# OPENCODE_GO_MAX_TOKENS=4000
# OPENCODE_GO_TIMEOUT=60
