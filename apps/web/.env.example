# Copy to `.env.local` for `npm run dev`. All .env* files are gitignored.

# Shared API key the Next proxy (src/proxy.ts) injects when forwarding /api/*
# to the Go API. MUST match apps/api/.env's API_KEY, or the API returns 401.
API_KEY=change-me-to-a-long-random-string

# Must exactly match the API service's SESSION_SECRET.
SESSION_SECRET=change-me-to-another-long-random-string

# Where the Next server forwards /api/* (server-side only; the browser always
# talks to localhost:3000). Docker sets this to the api service name.
# API_INTERNAL_URL=http://localhost:8080
