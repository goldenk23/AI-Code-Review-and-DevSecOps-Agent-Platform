# Copy this file to `.env` and fill in real values.
# `.env` is gitignored -- never commit real secrets.

REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgres://review:reviewpass@localhost:5432/ai_review
AI_SERVICE_URL=http://localhost:8000
API_BASE_URL=http://localhost:8080
# Must match the API service's API_KEY in deployed/shared environments.
API_KEY=change-me-to-a-long-random-string

# Optional: identify this worker in logs when running several (default 1).
# WORKER_ID=1
# Optional: Prometheus metrics port (default 9090; use 9091/9092 for extra workers).
# METRICS_PORT=9090


# Repository tests execute cloned code. Defaults on in dev/test and off elsewhere.
# Set true only when every reviewed repository/PR author is trusted.
# RUN_REPOSITORY_TESTS=false
