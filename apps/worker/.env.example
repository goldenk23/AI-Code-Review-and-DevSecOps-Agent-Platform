# Copy this file to `.env` and fill in real values.
# `.env` is gitignored -- never commit real secrets.

REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgres://review:reviewpass@localhost:5432/ai_review
AI_SERVICE_URL=http://localhost:8000

# Optional: identify this worker in logs when running several (default 1).
# WORKER_ID=1
# Optional: Prometheus metrics port (default 9090; use 9091/9092 for extra workers).
# METRICS_PORT=9090
